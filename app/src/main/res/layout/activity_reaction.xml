<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/lab_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <TextView android:id="@+id/txtBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹ Back" android:textColor="@color/lab_primary" android:textSize="16sp" android:padding="4dp" android:layout_marginTop="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚡ Reaction-Time Tester" android:textColor="@color/lab_text_primary" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="220dp"
            app:cardCornerRadius="20dp" app:cardElevation="6dp" android:layout_marginBottom="20dp">
            <FrameLayout android:id="@+id/reactionArea" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lab_surface">
                <TextView android:id="@+id/txtPrompt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="Tap Start" android:textColor="@color/lab_text_primary" android:textSize="20sp" android:textStyle="bold" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Start" android:layout_marginBottom="16dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@color/lab_surface" android:padding="12dp" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAST" android:textColor="@color/lab_text_secondary" android:textSize="12sp" />
                <TextView android:id="@+id/txtLast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="— ms" android:textColor="@color/lab_primary" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@color/lab_surface" android:padding="12dp" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BEST" android:textColor="@color/lab_text_secondary" android:textSize="12sp" />
                <TextView android:id="@+id/txtBest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="— ms" android:textColor="@color/lab_accent" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Physics / physiology behind this measurement" android:textColor="@color/lab_text_primary" android:textStyle="bold" android:textSize="15sp" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tap Start, wait for the card to turn green, then tap it as fast as you can. Timing uses System.nanoTime(), a monotonic high-resolution clock unaffected by wall-clock adjustments, so the measured interval is a true elapsed-time measurement, not a simulated one. Typical human visual-stimulus reaction time is roughly 200-300 ms, reflecting the time for light to trigger a retinal signal, travel to the visual cortex, get processed, and produce a motor response in your finger - real sensory-motor latency, not a network or software delay."
            android:textColor="@color/lab_text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
