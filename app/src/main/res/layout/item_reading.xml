<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@color/lab_surface"
    android:padding="14dp" android:layout_marginBottom="8dp" android:gravity="center_vertical">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/txtLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lab_text_primary" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lab_text_secondary" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/txtValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lab_primary" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
