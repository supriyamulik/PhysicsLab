<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/lab_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:id="@+id/txtBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹ Back" android:textColor="@color/lab_primary" android:textSize="16sp" android:padding="4dp" android:layout_marginTop="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🌀 Gyroscope Reader" android:textColor="@color/lab_text_primary" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/txtSensorInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sensor: —" android:textColor="@color/lab_text_secondary" android:textSize="12sp" android:layout_marginBottom="16dp" />

        <TextView android:id="@+id/txtUnavailable" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚠ Gyroscope not available on this device." android:textColor="@color/lab_danger" android:textSize="14sp"
            android:padding="12dp" android:background="@color/lab_surface" android:visibility="gone" android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/lab_surface" app:cardElevation="6dp" android:layout_marginBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESULTANT ANGULAR VELOCITY (ω)" android:textColor="@color/lab_text_secondary" android:textSize="12sp" android:letterSpacing="0.1" />
                <TextView android:id="@+id/txtResultant" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="@color/lab_primary" android:textSize="52sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="radians / second (rad/s)" android:textColor="@color/lab_text_secondary" android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@color/lab_surface" android:padding="12dp" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X (pitch)" android:textColor="@color/lab_danger" android:textStyle="bold" />
                <TextView android:id="@+id/txtX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="@color/lab_text_primary" android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@color/lab_surface" android:padding="12dp" android:layout_marginHorizontal="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y (roll)" android:textColor="@color/lab_accent" android:textStyle="bold" />
                <TextView android:id="@+id/txtY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="@color/lab_text_primary" android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@color/lab_surface" android:padding="12dp" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Z (yaw)" android:textColor="@color/lab_primary" android:textStyle="bold" />
                <TextView android:id="@+id/txtZ" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="@color/lab_text_primary" android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Physics behind this measurement" android:textColor="@color/lab_text_primary" android:textStyle="bold" android:textSize="15sp" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="TYPE_GYROSCOPE reports the phone's angular velocity around each axis in radians per second - how fast it is rotating, not how far it has turned. The resultant ω = √(ωx² + ωy² + ωz²) is the total rotation rate regardless of axis. At rest this should read close to 0; rotate the phone about any axis to see it rise. Integrating ω over time (∫ω dt) is how sensor fusion derives orientation, but that integral drifts over time without correction from the accelerometer/magnetometer."
            android:textColor="@color/lab_text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
