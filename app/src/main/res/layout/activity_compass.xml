<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/lab_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <TextView android:id="@+id/txtBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹ Back" android:textColor="@color/lab_primary" android:textSize="16sp" android:padding="4dp" android:layout_marginTop="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🧭 Compass" android:textColor="@color/lab_text_primary" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/txtSensorInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sensor: —" android:textColor="@color/lab_text_secondary" android:textSize="12sp" android:layout_marginBottom="16dp" />

        <TextView android:id="@+id/txtUnavailable" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚠ Accelerometer + magnetometer required for a compass are not both available." android:textColor="@color/lab_danger" android:textSize="14sp"
            android:padding="12dp" android:background="@color/lab_surface" android:visibility="gone" android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/lab_surface" app:cardElevation="6dp" android:layout_marginBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp">
                <ImageView android:id="@+id/imgNeedle" android:layout_width="140dp" android:layout_height="140dp"
                    android:src="@drawable/ic_compass_needle" android:contentDescription="Compass needle" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HEADING" android:textColor="@color/lab_text_secondary" android:textSize="12sp" android:letterSpacing="0.1" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/txtResultant" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0°" android:textColor="@color/lab_primary" android:textSize="44sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/txtDirection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N" android:textColor="@color/lab_text_secondary" android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Physics behind this measurement" android:textColor="@color/lab_text_primary" android:textStyle="bold" android:textSize="15sp" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="The compass combines TYPE_ACCELEROMETER (to find 'down', i.e. gravity) and TYPE_MAGNETIC_FIELD (to find magnetic North) via SensorManager.getRotationMatrix() and getOrientation(). This is called tilt compensation: it corrects the magnetic reading for however the phone is tilted in your hand, so heading stays accurate whether the phone is flat or angled. Accuracy degrades near magnets, metal objects, or speakers - if the heading looks wrong, move away from metal and wave the phone in a figure-8 to help the magnetometer recalibrate."
            android:textColor="@color/lab_text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
