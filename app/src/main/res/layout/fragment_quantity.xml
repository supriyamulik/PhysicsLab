<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lab_bg">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvQuantityTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/lab_text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/inter_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/chipAccuracy"
            tools:text="Magnetic Field" />

        <!-- Accuracy Status Badge -->
        <TextView
            android:id="@+id/chipAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/lab_primary"
            android:textSize="11sp"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintEnd_toStartOf="@+id/btnQuantityInfo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="High Accuracy" />

        <!-- Info button (48dp touch target) -->
        <ImageButton
            android:id="@+id/btnQuantityInfo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_info"
            android:contentDescription="Sensor Hardware Information"
            app:tint="@color/lab_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Calibration Alert Banner (shown when magnetometer needs calibration) -->
    <LinearLayout
        android:id="@+id/bannerCalibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill_accent"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvCalibrationHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calibration needed: move your device in a figure-8 pattern"
            android:textColor="@color/lab_warning"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium" />
    </LinearLayout>

    <!-- Segmented Tab Bar [ Live | History | Statistics ] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/btnTabLive"
            style="@style/TabSegmentButton.Selected"
            android:text="Live" />

        <TextView
            android:id="@+id/btnTabHistory"
            style="@style/TabSegmentButton"
            android:text="History" />

        <TextView
            android:id="@+id/btnTabStats"
            style="@style/TabSegmentButton"
            android:text="Statistics" />

    </LinearLayout>

    <!-- ViewPager2 hosting Live / History / Statistics sections -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/quantityViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
