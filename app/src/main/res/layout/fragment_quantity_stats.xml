<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/lab_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Content Layout (Visible when >= 1 reading) -->
        <LinearLayout
            android:id="@+id/layoutStatsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Row 1: Average & Latest Summary Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="12dp">

                <!-- Average Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginRight="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/lab_card_border"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/lab_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStatsAverageLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Average"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_medium" />

                        <TextView
                            android:id="@+id/tvStatsAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/lab_primary"
                            android:textSize="22sp"
                            android:fontFamily="@font/inter_bold"
                            tools:text="48.20 µT" />

                        <TextView
                            android:id="@+id/tvStatsSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="All measurements"
                            android:textColor="@color/lab_text_tertiary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_regular"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Latest Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginLeft="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/lab_card_border"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/lab_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latest Reading"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_medium" />

                        <TextView
                            android:id="@+id/tvStatsLatest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/lab_text_primary"
                            android:textSize="22sp"
                            android:fontFamily="@font/inter_bold"
                            tools:text="49.10 µT" />

                        <TextView
                            android:id="@+id/tvStatsLatestSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Most recent"
                            android:textColor="@color/lab_text_tertiary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_regular"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Row 2: Min / Max / Count Metrics Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/lab_card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/lab_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:baselineAligned="false">

                    <!-- Min -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Min Recorded"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_regular" />

                        <TextView
                            android:id="@+id/tvStatsMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/lab_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_bold"
                            tools:text="25.4 µT" />

                        <TextView
                            android:id="@+id/tvStatsMinSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textColor="@color/lab_text_tertiary"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_regular"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="Bench Test" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/lab_card_border" />

                    <!-- Max -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Max Recorded"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_regular" />

                        <TextView
                            android:id="@+id/tvStatsMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/lab_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_bold"
                            tools:text="62.8 µT" />

                        <TextView
                            android:id="@+id/tvStatsMaxSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textColor="@color/lab_text_tertiary"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_regular"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="Magnet Close" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/lab_card_border" />

                    <!-- Total Count -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Captures"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_regular" />

                        <TextView
                            android:id="@+id/tvStatsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/lab_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_bold"
                            tools:text="14" />

                        <TextView
                            android:id="@+id/tvStatsCountSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="saved readings"
                            android:textColor="@color/lab_text_tertiary"
                            android:textSize="10sp"
                            android:fontFamily="@font/inter_regular" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row 3: Native Canvas Timeline Chart Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/lab_card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/lab_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row with title and cap indicator badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Saved Values Timeline"
                            android:textColor="@color/lab_text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_semibold" />

                        <TextView
                            android:id="@+id/tvChartCapIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/lab_primary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_medium"
                            android:background="@drawable/bg_tab_unselected"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            tools:text="14 readings" />

                    </LinearLayout>

                    <!-- Native Canvas Timeline Line Chart -->
                    <com.physicslab.app.ui.view.TimelineChartView
                        android:id="@+id/timelineChartView"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />

                    <!-- Inspection / Selected Point Info Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_tab_unselected"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tvSelectedPointInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/lab_text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Tap or scrub along the chart to inspect saved readings." />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- 2. Empty State Layout (Visible when 0 readings) -->
        <LinearLayout
            android:id="@+id/layoutStatsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="48sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Saved Readings Yet"
                android:textColor="@color/lab_text_primary"
                android:textSize="18sp"
                android:fontFamily="@font/inter_bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capture measurements in the Live tab to view historical trends, timeline graphs, and statistical distributions."
                android:textColor="@color/lab_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToLiveFromStats"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Go to Live"
                android:textColor="@color/lab_surface"
                android:fontFamily="@font/inter_semibold"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/lab_primary" />

        </LinearLayout>

    </FrameLayout>

</androidx.core.widget.NestedScrollView>
